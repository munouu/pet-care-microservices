    {
      "name": "3. Уход и доступ",
      "item": [
        {
          "name": "Запланировать кормление",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{ownerId}}"
              },
              {
                "key": "X-Role",
                "value": "OWNER"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/care/tasks",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"petId\": \"{{petId}}\",\n  \"title\": \"Кормление\",\n  \"scheduledAt\": \"{{taskAt}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"taskAt\", new Date(Date.now()+3600000).toISOString());",
                  "pm.environment.set(\"calFrom\", new Date(Date.now()-60000).toISOString());",
                  "pm.environment.set(\"calTo\", new Date(Date.now()+3*86400000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",

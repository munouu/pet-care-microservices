{
  "info": {
    "_postman_id": "196b86fb-4871-41e3-9cce-c1709fe1621e",
    "name": "Pet Care — ЛР4",
    "description": "Запросы через Gateway. Папки 0–2 — основная демонстрация; 3–4 — дополнительные функции. Выполнять запросы вручную сверху вниз.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Подготовка",
      "item": [
        {
          "name": "Gateway health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": ""
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const base = Date.now();",
                  "pm.environment.set(\"rangeFrom\", new Date(base).toISOString());",
                  "pm.environment.set(\"rangeTo\", new Date(base + 4*3600000).toISOString());",
                  "pm.environment.set(\"happyStart\", new Date(base + 3600000).toISOString());",
                  "pm.environment.set(\"happyEnd\", new Date(base + 5400000).toISOString());",
                  "pm.environment.set(\"failStart\", new Date(base + 7200000).toISOString());",
                  "pm.environment.set(\"failEnd\", new Date(base + 9000000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.test(\"Gateway UP\", () => pm.expect(data.status).to.eql(\"UP\"));",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Создать питомца",

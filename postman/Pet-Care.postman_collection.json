          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.test(\"Слот отсутствует в свободных\", () => pm.expect(data.items.map(x => x.id)).not.to.include(pm.environment.get(\"happySlotId\")));",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Уведомления",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{ownerId}}"
              },
              {
                "key": "X-Role",
                "value": "OWNER"
              }
            ],
            "url": "{{baseUrl}}/api/v1/notifications",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.test(\"Подтверждение отправлено\", () => pm.expect(data.items.some(x => x.kind === \"APPOINTMENT_CONFIRMED\" && x.status === \"SENT\")).to.eql(true));",
                  "}"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },

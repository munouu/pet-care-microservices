    {
      "name": "1. Успешная запись",
      "item": [
        {
          "name": "Создать запись",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{ownerId}}"
              },
              {
                "key": "X-Role",
                "value": "OWNER"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{happyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/appointments",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"petId\": \"{{petId}}\",\n  \"slotId\": \"{{happySlotId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"happyKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  pm.environment.set(\"happyAppointmentId\", data.id);",
                  "  pm.test(\"status = PENDING_PAYMENT\", () => pm.expect(data.status).to.eql(\"PENDING_PAYMENT\"));",
                  "  pm.environment.set(\"happyAppointmentIdCorrelation\", pm.response.headers.get(\"X-Correlation-Id\"));",
                  "  pm.test(\"paymentUrl получен\", () => pm.expect(data.paymentUrl).to.be.a(\"string\"));",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Повторить тот же POST",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{ownerId}}"
              },
              {
                "key": "X-Role",
                "value": "OWNER"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{happyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/appointments",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"petId\": \"{{petId}}\",\n  \"slotId\": \"{{happySlotId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  pm.test(\"Тот же appointmentId\", () => pm.expect(data.id).to.eql(pm.environment.get(\"happyAppointmentId\")));",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Оплата успешна",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/mock/payments/{{happyAppointmentId}}/result",
            "description": "Мок PSP отправит подписанный webhook через Gateway.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SUCCEEDED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.test(\"status = SUCCEEDED\", () => pm.expect(data.status).to.eql(\"SUCCEEDED\"));",
                  "  pm.test(\"Callback принят\", () => pm.expect(data.callbackStatus).to.eql(200));",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Проверить CONFIRMED",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{ownerId}}"
              },
              {
                "key": "X-Role",
                "value": "OWNER"
              }
            ],
            "url": "{{baseUrl}}/api/v1/appointments/{{happyAppointmentId}}",
            "description": "Если событие ещё в очереди, повторить запрос через 1–3 секунды."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.test(\"status = CONFIRMED\", () => pm.expect(data.status).to.eql(\"CONFIRMED\"));",
                  "  pm.test(\"paymentStatus = PAID\", () => pm.expect(data.paymentStatus).to.eql(\"PAID\"));",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Слот больше не свободен",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{ownerId}}"
              },
              {
                "key": "X-Role",
                "value": "OWNER"
              }
            ],
